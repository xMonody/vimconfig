host=$(printf "%s\n" $(awk '/^[[:space:]]*Host[[:space:]]+/ {
    for (i = 2; i <= NF; i++)
        if ($i !~ /[*?!]/ && !seen[$i]++) print $i
}' ~/.ssh/config) "Zsh Shell" "Fish Shell" | fzf --no-preview)

[ -z "$host" ] && exit 0

case "$host" in
    "Zsh Shell")  kitty @ launch --type=tab --tab-title "zsh"  zsh ;;
    "Fish Shell") kitty @ launch --type=tab --tab-title "fish" fish ;;
    *) kitty @ launch --type=tab --tab-title "$host" --hold ssh "$host" ;;
esac
