#!/bin/sh
set -e
cd "$(dirname "$0")"
command -v passt >/dev/null || { printf '\033[31mpasst not install\033[0m\n' >&2; exit 1; }
#[ -e ./stpm/tpm.sock ] && rm -f ./stpm/tpm.sock || true
#[ -e ./passt.sock ] && rm -f ./passt.sock || true
[ -e ./qemu.log ] && : > ./qemu.log || true

#QNET="-netdev user,id=net,hostfwd=tcp::2222-:22 -device virtio-net-device,netdev=net"
#passt -s passt.sock -t 2222:22 > /dev/null 2>&1
#QNET="-device virtio-net-device,netdev=s -netdev stream,id=s,server=off,addr.type=unix,addr.path=passt.sock"
QNET="-netdev passt,id=net,tcp-ports=2222:22 -device virtio-net-pci,netdev=net"

#QGPU="-vga none -display sdl,gl=on -device virtio-gpu-gl,hostmem=1G,blob=on" #venus=true,drm_native_context=on
#QGPU="-vga none -display none -D ./qemu.log -daemonize" # -nographic -show-cursor=on
QGPU="-vga virtio -display sdl"

OVMF="/usr/share/OVMF/OVMF_CODE_4M.fd" VARS="./OVMF_VARS_4M.fd"
UEFI="-drive if=pflash,format=raw,readonly=on,file=$OVMF -drive if=pflash,format=raw,file=$VARS"

QAIO="-audiodev pipewire,id=pw -device ich9-intel-hda -device hda-duplex,audiodev=pw" #hda-micro hda-output

QROM=""; if [ -n "$1" ]; then
QROM="-device ide-cd,drive=cdrom,bootindex=0 -drive if=none,id=cdrom,format=raw,file=$1"; fi
FILE="-virtfs local,path=$HOME/virtual/share,mount_tag=hostshare,security_model=mapped-xattr"

QEMU_BIN="qemu-system-x86_64 -accel kvm -machine q35 -cpu host -smp 4,sockets=1,cores=4,threads=1 -m 5G"
#QEMU_BIN="qemu-system-aarch64 -accel kvm -machine virt,gic-version=3,acpi=on -cpu host -smp 4 -m 5G"
#QEMU_BIN="qemu-system-loongarch64 -accel tcg,thread=multi -machine virt -cpu la464 -smp 4 -m 5G"

# tpm2芯片 # 重启丢失操作-snapshot [threads|native|io_uring]
#nohup swtpm socket --tpm2 --tpmstate dir=./stpm --ctrl type=unixio,path=./stpm/tpm.sock > /dev/null 2>&1 &
#SWTPM="-chardev socket,id=t,path=./stpm/tpm.sock -tpmdev emulator,id=p,chardev=t -device tpm-tis,tpmdev=p"

$QEMU_BIN -drive file=base.qcow2,if=virtio,format=qcow2,aio=io_uring,snapshot=off $UEFI $QROM \
    -device virtio-balloon-pci,free-page-reporting=on $QNET $QGPU \
    $QAIO -device qemu-xhci -device usb-tablet -device usb-kbd #> ./qemu.log 2>&1 &

