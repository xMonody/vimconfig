pointer:#7C73B0,current-bg:#585d73,current-fg:-1:regular"

set fzf_fish $HOME/.config/fzf/fzf.fish
set zoxide_fish $HOME/.config/zoxide/zoxide.fish

if test -f $fzf_fish
    source $fzf_fish
else if type -q fzf              # 用 else if 减少嵌套
    mkdir -p $HOME/.config/fzf
    fzf --fish > $fzf_fish
    source $fzf_fish
else
#echo "Warning: fzf command not found, skip fzf integration" >&2
end

if test -f $zoxide_fish
    source $zoxide_fish
else if type -q zoxide           # 用 else if 减少嵌套
    mkdir -p $HOME/.config/zoxide
    zoxide init fish > $zoxide_fish
    source $zoxide_fish
else
#echo "Warning: zoxide command not found, skip zoxide integration" >&2
end

