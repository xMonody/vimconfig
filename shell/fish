function toggle_proxy --description "toggle HTTP/HTTPS proxy"
    set -l default_ip "127.0.0.1"
    set -l port "10809"
    set -l toggle_var "__PROXY_ENABLED"

    if set -q NATPROXY
        set -l gateway (ip route show default 2>/dev/null \
            | string match -r 'via (\S+)' \
            | string replace -r '.*via ' '' \
            | head -n 1)
        if test -n "$gateway"
            set default_ip "$gateway"
        end
    end

    set -l custom_ip $argv[1]
    if set -q $toggle_var
        set -e HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
        set -e $toggle_var
        return 0
    end
    set -l target_ip
    if test -z "$custom_ip"
        set target_ip "http://$default_ip:$port"
    else
        set target_ip "http://192.168.$custom_ip:$port"
    end
    set -gx HTTP_PROXY  $target_ip
    set -gx HTTPS_PROXY $target_ip
    set -gx http_proxy  $target_ip
    set -gx https_proxy $target_ip
    set -gx $toggle_var 1
end
alias proxy toggle_proxy

if status is-interactive
